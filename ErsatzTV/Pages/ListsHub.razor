@page "/lists"
@inject IStringLocalizer<ErsatzTV.Locals.Shared.MainLayout> Loc

<MudForm Style="max-height: 100%">
    <div class="d-flex flex-column" style="height: 100vh; overflow-x: auto">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-8">
            <PageHeader Title="@Loc["ButtonLists"]"
                        Subtitle="Collections, smart collections, and playlists"/>
            <PageSurface>
                <MudText Typo="Typo.h6" Class="mb-3">Primary</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="mb-6">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="media/collections" StartIcon="@Icons.Material.Filled.Collections">
                        @Loc["ButtonListsManualCollections"]
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="media/smart-collections" StartIcon="@Icons.Material.Filled.AutoAwesome">
                        @Loc["ButtonListsSmartCollections"]
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="media/playlists" StartIcon="@Icons.Material.Filled.QueueMusic">
                        @Loc["ButtonListsPlaylists"]
                    </MudButton>
                </MudStack>

                <MudExpansionPanels Elevation="0">
                    <MudExpansionPanel Text="More" Dense="true">
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                            <MudButton Variant="Variant.Outlined" Href="media/multi-collections" StartIcon="@Icons.Material.Filled.LibraryAdd">
                                @Loc["ButtonListsMultiCollections"]
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Href="media/rerun-collections" StartIcon="@Icons.Material.Filled.Replay">
                                @Loc["ButtonListsRerunCollections"]
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Href="media/trakt/lists" StartIcon="@Icons.Material.Filled.FormatListBulleted">
                                @Loc["ButtonListsTraktLists"]
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Href="media/filler/presets" StartIcon="@Icons.Material.Filled.MoreTime">
                                @Loc["ButtonListsFillerPresets"]
                            </MudButton>
                        </MudStack>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </PageSurface>
        </MudContainer>
    </div>
</MudForm>
