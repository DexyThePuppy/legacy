@page "/overlays/{Id:int}/test"
@using System.Globalization
@using System.Text
@using System.Text.RegularExpressions
@using ErsatzTV.Application.Graphics
@using ErsatzTV.Core
@using ErsatzTV.FFmpeg.State
@implements IAsyncDisposable
@inject NavigationManager NavigationManager
@inject ILogger<OverlayTest> Logger
@inject ISnackbar Snackbar
@inject IMediator Mediator
@inject IJSRuntime JsRuntime

<div class="overlay-test">
    <MudPaper Square="true" Class="page-toolbar overlay-test-bar" Elevation="0">
        <MudButton Variant="Variant.Text" Class="ml-2" Href="overlays" StartIcon="@Icons.Material.Filled.ArrowBack">
            Back
        </MudButton>
        <MudText Typo="Typo.subtitle1" Class="ml-2">@_model.Name</MudText>
        <MudSpacer/>
        <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary" Class="mr-3">
            <MudButton Variant="@(_overlayVisible ? Variant.Filled : Variant.Outlined)" OnClick="@(_ => SetVisibilityAsync(true))">Show</MudButton>
            <MudButton Variant="@(!_overlayVisible ? Variant.Filled : Variant.Outlined)" OnClick="@(_ => SetVisibilityAsync(false))">Hide</MudButton>
        </MudButtonGroup>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   Class="mr-3"
                   StartIcon="@Icons.Material.Filled.OpenInNew"
                   Href="@RawHtmlHref"
                   Target="_blank">
            Raw HTML
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mr-4" StartIcon="@Icons.Material.Filled.Save" OnClick="@(_ => SaveAsync())">
            Save
        </MudButton>
    </MudPaper>

    <div class="overlay-test-body">
        <div class="overlay-test-preview-pane">
            <div class="overlay-test-stage-host">
                <div class="overlay-test-stage">
                    <div class="overlay-test-backdrop"></div>
                    <iframe id="@_iframeId"
                            title="Overlay preview"
                            class="overlay-test-frame"
                            style="@FrameStyle"
                            sandbox="allow-scripts"
                            referrerpolicy="no-referrer">
                    </iframe>
                </div>
            </div>
        </div>

        <div class="overlay-test-editor">
            <div class="overlay-test-sample d-flex gap-2 mb-3">
                <MudTextField T="string" Label="Title" @bind-Value="_title" @bind-Value:after="QueueRenderAsync" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                <MudTextField T="string" Label="Next Title" @bind-Value="_nextTitle" @bind-Value:after="QueueRenderAsync" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"/>
            </div>
            <div class="overlay-test-tabs">
                <div class="overlay-test-tabbar">
                    <button type="button" class="@TabClass(EditorTab.Html)" @onclick="@(() => _editorTab = EditorTab.Html)">HTML</button>
                    <button type="button" class="@TabClass(EditorTab.Css)" @onclick="@(() => _editorTab = EditorTab.Css)">CSS</button>
                    <button type="button" class="@TabClass(EditorTab.Js)" @onclick="@(() => _editorTab = EditorTab.Js)">JS</button>
                    <button type="button" class="@TabClass(EditorTab.Triggers)" @onclick="@(() => _editorTab = EditorTab.Triggers)">Triggers</button>
                </div>
                <div class="overlay-test-tab-panel">
                    @if (_editorTab == EditorTab.Html)
                    {
                        <MudTextField T="string"
                                      Class="overlay-test-code"
                                      @bind-Value="_htmlPart"
                                      @bind-Value:after="ComposeAndRenderAsync"
                                      Immediate="true"
                                      Lines="20"
                                      Variant="Variant.Outlined"
                                      Style="font-family: ui-monospace, Consolas, monospace; font-size: 12px"/>
                    }
                    else if (_editorTab == EditorTab.Css)
                    {
                        <MudTextField T="string"
                                      Class="overlay-test-code"
                                      @bind-Value="_cssPart"
                                      @bind-Value:after="ComposeAndRenderAsync"
                                      Immediate="true"
                                      Lines="20"
                                      Variant="Variant.Outlined"
                                      Style="font-family: ui-monospace, Consolas, monospace; font-size: 12px"/>
                    }
                    else if (_editorTab == EditorTab.Js)
                    {
                        <MudTextField T="string"
                                      Class="overlay-test-code"
                                      @bind-Value="_jsPart"
                                      @bind-Value:after="ComposeAndRenderAsync"
                                      Immediate="true"
                                      Lines="20"
                                      Variant="Variant.Outlined"
                                      Style="font-family: ui-monospace, Consolas, monospace; font-size: 12px"/>
                    }
                    else
                    {
                        <div class="overlay-test-triggers">
                            <div class="overlay-test-trigger-group">
                                <p class="overlay-test-trigger-title">Visibility</p>
                                <div class="overlay-test-trigger-actions">
                                    <MudButton Variant="@(_overlayVisible ? Variant.Filled : Variant.Outlined)"
                                               Color="Color.Primary"
                                               OnClick="@(_ => SetVisibilityAsync(true))">
                                        Show
                                    </MudButton>
                                    <MudButton Variant="@(!_overlayVisible ? Variant.Filled : Variant.Outlined)"
                                               Color="Color.Primary"
                                               OnClick="@(_ => SetVisibilityAsync(false))">
                                        Hide
                                    </MudButton>
                                </div>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
                                    Plays the overlay enter / exit animation without remounting the preview.
                                </MudText>
                            </div>

                            <div class="overlay-test-trigger-group">
                                <p class="overlay-test-trigger-title">Index</p>
                                <div class="overlay-test-trigger-actions">
                                    <MudIconButton Icon="@Icons.Material.Filled.Remove"
                                                   Variant="Variant.Outlined"
                                                   Color="Color.Primary"
                                                   Disabled="@(_epgIndex <= 0)"
                                                   OnClick="@(_ => ShiftEpgIndexAsync(-1))"/>
                                    <MudText Typo="Typo.h6" Class="overlay-test-trigger-index">@_epgIndex</MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                                   Variant="Variant.Outlined"
                                                   Color="Color.Primary"
                                                   Disabled="@(_epgIndex >= GetOverlayPreviewHtmlHandler.SampleEpgCount - 1)"
                                                   OnClick="@(_ => ShiftEpgIndexAsync(1))"/>
                                </div>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
                                    Re-plays the enter animation, then slides to the next index.
                                </MudText>
                            </div>
                        </div>
                    }
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_renderError))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_renderError</MudAlert>
            }
        </div>
    </div>
</div>

<style>
    .overlay-test {
        display: flex;
        flex-direction: column;
        height: calc(100vh - var(--mud-appbar-height, 64px));
        max-height: calc(100vh - var(--mud-appbar-height, 64px));
        width: 100%;
        max-width: 100%;
        overflow: hidden;
    }

    .overlay-test-bar {
        display: flex;
        align-items: center;
        height: 56px;
        min-height: 56px;
        z-index: 2;
    }

    .overlay-test-body {
        display: flex;
        flex: 1;
        min-height: 0;
        overflow: hidden;
    }

    .overlay-test-preview-pane {
        flex: 1 1 55%;
        min-width: 0;
        padding: 0;
        overflow: hidden;
    }

    .overlay-test-editor {
        flex: 1 1 45%;
        min-width: 320px;
        max-width: 560px;
        padding: 0.75rem;
        overflow: auto;
        border-left: 1px solid rgba(255,255,255,0.08);
        display: flex;
        flex-direction: column;
    }

    .overlay-test-sample > * {
        flex: 1;
    }

    .overlay-test-tabs {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .overlay-test-tabbar {
        display: flex;
        width: 100%;
        border-bottom: 1px solid rgba(255,255,255,0.12);
    }

    .overlay-test-tabbar > button {
        flex: 1 1 0;
        min-width: 0;
        height: 44px;
        border: 0;
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
        background: transparent;
        color: rgba(255,255,255,0.75);
        font: 600 0.875rem/1 "Segoe UI", system-ui, sans-serif;
        letter-spacing: 0.04em;
        cursor: pointer;
    }

    .overlay-test-tabbar > button:hover {
        color: #fff;
        background: rgba(255,255,255,0.04);
    }

    .overlay-test-tabbar > button.active {
        color: var(--mud-palette-primary);
        border-bottom-color: var(--mud-palette-primary);
    }

    .overlay-test-tab-panel {
        flex: 1;
        min-height: 0;
        padding-top: 0.75rem;
        overflow: hidden;
    }

    .overlay-test-code {
        height: 100%;
    }

    .overlay-test-triggers {
        height: 100%;
        overflow: auto;
        padding-right: 0.25rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .overlay-test-trigger-group {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .overlay-test-trigger-title {
        margin: 0;
        font: 600 0.75rem/1.2 "Segoe UI", system-ui, sans-serif;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.55);
    }

    .overlay-test-trigger-actions {
        display: flex;
